rules_version = '2';

// Who can do what:
//  - Orders: a customer must be signed in. They can ADD an order under their own account (the order number is
//    the document name, so it can never be overwritten) and read only their own orders.
//    Only the shop admin (signed in with the admin email) can read all orders or change a status. Nobody can delete.
//  - Payment screenshots: only the customer who placed that order can add one; only the admin can read or delete them.
//  - Purchases, sales and expenses (the shop-management pages): only the admin can read or write them.
//  - Products, payment methods, website text and wording: anyone can READ them (that is what the website shows).
//    Only the shop admin can add, change or delete them.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['__ADMIN_EMAIL__'];
    }

    function signedIn() {
      return request.auth != null;
    }

    function validOrder(orderId) {
      let d = request.resource.data;
      let keys = ['orderNo', 'uid', 'email', 'name', 'contact', 'delivery', 'address', 'notes', 'items', 'total', 'agreed', 'status', 'createdAt'];
      return signedIn()
        && d.keys().hasOnly(keys) && d.keys().hasAll(keys)
        && d.orderNo is string && d.orderNo.matches('MH-[A-Z0-9]{3,18}') && orderId == d.orderNo
        && d.uid == request.auth.uid
        && d.email is string && d.email.size() <= 200 && d.email == request.auth.token.email
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.contact is string && d.contact.size() > 0 && d.contact.size() <= 100
        && d.delivery is string && d.delivery.size() <= 100
        && d.address is string && d.address.size() <= 500
        && d.notes is string && d.notes.size() <= 1000
        && d.items is list && d.items.size() > 0 && d.items.size() <= 40
        && d.total is number && d.total >= 0 && d.total < 1000000
        && d.agreed == true
        && d.status == 'new'
        && d.createdAt == request.time;
    }

    function optStr(d, k, max) {
      return !(k in d) || (d[k] is string && d[k].size() <= max);
    }
    function optList(d, k) {
      return !(k in d) || (d[k] is list && d[k].size() <= 6);
    }

    function validProduct() {
      let d = request.resource.data;
      let keys = ['group', 'name', 'price', 'tag', 'image', 'status', 'order'];
      return d.keys().hasOnly(['group', 'name', 'price', 'tag', 'image', 'status', 'order', 'channels', 'eta', 'stock', 'aliases', 'addons']) && d.keys().hasAll(keys)
        && (!('stock' in d) || (d.stock is number && d.stock > -100000 && d.stock < 100000))
        && (!('aliases' in d) || (d.aliases is list && d.aliases.size() <= 30))
        && (!('addons' in d) || (d.addons is list && d.addons.size() <= 12))
        && (!('channels' in d) || (d.channels is list && d.channels.size() <= 3 && d.channels.hasOnly(['stock', 'preorder', 'sf'])))
        && optStr(d, 'eta', 60)
        && d.group is string && d.group.size() > 0 && d.group.size() <= 60
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.price is number && d.price >= 0 && d.price < 1000000
        && d.tag is string && d.tag.size() <= 30
        && d.image is string && d.image.size() <= 400000
        && d.status in ['ok', 'sold', 'store', 'hidden']
        && d.order is number;
    }

    function validSite() {
      let d = request.resource.data;
      return d.keys().hasOnly(['headline', 'intro', 'shelfNote', 'hours', 'addressShort', 'addressLines', 'stall', 'enquiryNote', 'claims', 'instagram', 'paymentNote', 'ordersOpen'])
        && optStr(d, 'headline', 200) && optStr(d, 'intro', 600) && optStr(d, 'shelfNote', 300)
        && optStr(d, 'hours', 100) && optStr(d, 'addressShort', 150) && optStr(d, 'enquiryNote', 300)
        && optStr(d, 'claims', 300) && optStr(d, 'instagram', 60) && optStr(d, 'paymentNote', 500)
        && optList(d, 'addressLines') && optList(d, 'stall')
        && (!('ordersOpen' in d) || d.ordersOpen is bool);
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update: if isAdmin() && validProduct();
      allow delete: if isAdmin();
    }

    function validPayment() {
      let d = request.resource.data;
      let keys = ['name', 'type', 'details', 'link', 'image', 'order', 'enabled'];
      return d.keys().hasOnly(keys) && d.keys().hasAll(keys)
        && d.name is string && d.name.size() > 0 && d.name.size() <= 40
        && d.type in ['qr', 'text', 'link']
        && d.details is string && d.details.size() <= 600
        && d.link is string && d.link.size() <= 300 && (d.link == '' || d.link.matches('https://.*'))
        && d.image is string && d.image.size() <= 400000
        && d.order is number
        && d.enabled is bool;
    }

    // Payment screenshots that customers upload on the payment page. Only the admin can see them.
    // The order must exist and belong to the signed-in customer.
    function validProof() {
      let d = request.resource.data;
      return signedIn()
        && d.keys().hasOnly(['orderNo', 'image', 'note', 'createdAt'])
        && d.orderNo is string && d.orderNo.matches('MH-[A-Z0-9]{3,18}')
        && d.image is string && d.image.size() <= 400000 && d.image.matches('data:image/.*')
        && d.note is string && d.note.size() <= 200
        && d.createdAt == request.time
        && exists(/databases/$(database)/documents/orders/$(d.orderNo))
        && get(/databases/$(database)/documents/orders/$(d.orderNo)).data.uid == request.auth.uid;
    }

    match /proofs/{proofId} {
      allow create: if validProof();
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    match /payments/{paymentId} {
      allow read: if true;
      allow create, update: if isAdmin() && validPayment();
      allow delete: if isAdmin();
    }

    match /settings/site {
      allow read: if true;
      allow create, update: if isAdmin() && validSite();
      allow delete: if false;
    }

    // Wording of the website pages (every key is a piece of text; see the 全部文字 tab on the admin page).
    match /settings/texts {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['t'])
        && request.resource.data.t is map
        && request.resource.data.t.size() <= 700;
      allow delete: if false;
    }

    // ---- Shop management (admin page only): bulk orders / costs, sales records, rent and other costs ----
    function validPurchase() {
      let d = request.resource.data;
      return d.keys().hasOnly(['date', 'supplier', 'currency', 'rate', 'shipping', 'otherFees', 'allocate', 'note', 'lines', 'updatedAt'])
        && d.keys().hasAll(['date', 'currency', 'rate', 'shipping', 'otherFees', 'allocate', 'lines'])
        && d.date is string && d.date.size() == 10
        && optStr(d, 'supplier', 100) && optStr(d, 'note', 500)
        && d.currency in ['HKD', 'KRW', 'CNY', 'USD', 'JPY', 'TWD', 'EUR']
        && d.rate is number && d.shipping is number && d.otherFees is number
        && d.allocate in ['qty', 'value']
        && d.lines is list && d.lines.size() <= 80;
    }
    function validSale() {
      let d = request.resource.data;
      return d.keys().hasOnly(['date', 'time', 'receipt', 'payment', 'source', 'items', 'total', 'discount', 'note', 'orderNo', 'createdAt'])
        && d.keys().hasAll(['date', 'source', 'items', 'total'])
        && d.date is string && d.date.size() == 10
        && d.source in ['pos', 'import', 'web']
        && d.items is list && d.items.size() <= 150
        && d.total is number
        && optStr(d, 'time', 10) && optStr(d, 'receipt', 60) && optStr(d, 'payment', 30) && optStr(d, 'note', 300) && optStr(d, 'orderNo', 30);
    }
    function validExpense() {
      let d = request.resource.data;
      return d.keys().hasOnly(['date', 'name', 'category', 'amount', 'repeat', 'endDate', 'note'])
        && d.keys().hasAll(['date', 'name', 'category', 'amount', 'repeat'])
        && d.date is string && d.date.size() == 10
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.category in ['rent', 'other']
        && d.amount is number
        && d.repeat in ['none', 'monthly', 'yearly']
        && optStr(d, 'endDate', 10) && optStr(d, 'note', 300);
    }
    match /purchases/{id} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin() && validPurchase();
    }
    match /sales/{id} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin() && validSale();
    }
    match /expenses/{id} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin() && validExpense();
    }

    // ---- Membership: every registered account has a member record; points are added by the admin page ----
    function validMemberSelf(uid) {
      let d = request.resource.data;
      let keys = ['uid', 'email', 'name', 'points', 'spent', 'joinedAt'];
      return signedIn() && request.auth.uid == uid
        && d.keys().hasOnly(keys) && d.keys().hasAll(keys)
        && d.uid == uid && d.email == request.auth.token.email
        && d.name is string && d.name.size() <= 60
        && d.points == 0 && d.spent == 0
        && d.joinedAt == request.time;
    }
    function validMemberAdmin() {
      let d = request.resource.data;
      return d.keys().hasOnly(['uid', 'email', 'name', 'points', 'spent', 'joinedAt', 'note', 'updatedAt'])
        && d.keys().hasAll(['uid', 'email', 'points', 'spent'])
        && d.uid is string && d.email is string && d.points is number && d.spent is number
        && optStr(d, 'name', 60) && optStr(d, 'note', 300);
    }
    match /members/{uid} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create: if validMemberSelf(uid) || (isAdmin() && validMemberAdmin());
      allow update: if isAdmin() && validMemberAdmin();
      allow delete: if isAdmin();
    }
    function validPointLog() {
      let d = request.resource.data;
      return d.keys().hasOnly(['uid', 'orderNo', 'points', 'type', 'note', 'createdAt'])
        && d.keys().hasAll(['uid', 'points', 'type', 'createdAt'])
        && d.uid is string && d.points is number && d.type in ['earn', 'adjust', 'redeem']
        && optStr(d, 'orderNo', 30) && optStr(d, 'note', 200);
    }
    match /pointlogs/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if isAdmin() && validPointLog();
      allow update: if false;
      allow delete: if isAdmin();
    }
    match /settings/member {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['enabled', 'per', 'tiers'])
        && request.resource.data.enabled is bool && request.resource.data.per is number && request.resource.data.per > 0
        && request.resource.data.tiers is list && request.resource.data.tiers.size() <= 6;
      allow delete: if false;
    }

    match /orders/{orderId} {
      allow create: if validOrder(orderId);
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'progress', 'tracking', 'customerNote'])
        && request.resource.data.status in ['new', 'confirmed', 'done', 'cancelled']
        && (!('progress' in request.resource.data) || request.resource.data.progress in ['received', 'paid', 'ordering', 'arrived', 'shipped', 'ready', 'done'])
        && optStr(request.resource.data, 'tracking', 60) && optStr(request.resource.data, 'customerNote', 300);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
