rules_version = '2';

// Who can do what:
//  - Orders: a customer must be signed in with a verified email. They can ADD an order under their own account (the order number is
//    the document name, so it can never be overwritten) and read only their own orders.
//    Only the shop admin (signed in with the admin email) can read all orders, change a status or delete an order.
//  - Payment screenshots: only the customer who placed that order can add one; only the admin can read or delete them.
//  - Purchases, sales and expenses (the shop-management pages): only the admin can read or write them.
//  - Coming-soon products and extra pages: anyone can read the published ones; only the admin can change them.
//  - Payment methods (QR codes): only customers with a verified email (and the admin) can read them.
//  - Products, website text and wording: anyone can READ them (that is what the website shows).
//    Only the shop admin can add, change or delete them.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['__ADMIN_EMAIL__'];
    }

    function signedIn() {
      return request.auth != null;
    }

    // Customers must have verified their email address (they click the link in the email we send at sign-up).
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // A discount code on an order must be a real, active code, belong to this customer if it is limited to one email,
    // be inside its expiry date and minimum spend, be worth no more than its rate, and the same batch must raise
    // its use counters by exactly one (so the use limits cannot be skipped).
    function validOrderCode(d) {
      let base = /databases/$(database)/documents/codes/$(d.codeId);
      let c = get(base).data;
      let cAfter = getAfter(base).data;
      let sub = d.total + d.discount;
      return d.codeId is string && d.code is string && d.discount is number && d.discount > 0
        && c.active == true && d.code == c.code
        && (!('email' in c) || c.email == '' || c.email == d.email.lower())
        && (!('expiresAt' in c) || request.time < c.expiresAt)
        && (!('minSpend' in c) || sub >= c.minSpend)
        && (c.type == 'percent' ? d.discount <= sub * c.value / 100 + 0.01 : d.discount <= c.value)
        && cAfter.used == c.used + 1
        && (!('maxUses' in c) || c.maxUses == 0 || cAfter.used <= c.maxUses)
        && (!('perCustomer' in c) || c.perCustomer == 0
            || getAfter(/databases/$(database)/documents/codes/$(d.codeId)/uses/$(request.auth.uid)).data.n <= c.perCustomer);
    }

    function validOrder(orderId) {
      let d = request.resource.data;
      let keys = ['orderNo', 'uid', 'email', 'name', 'contact', 'delivery', 'address', 'notes', 'items', 'total', 'agreed', 'status', 'createdAt'];
      return verified()
        && d.keys().hasOnly(keys.concat(['code', 'codeId', 'discount'])) && d.keys().hasAll(keys)
        && (('code' in d) == ('codeId' in d)) && (('codeId' in d) == ('discount' in d))
        && (!('codeId' in d) || validOrderCode(d))
        && d.orderNo is string && d.orderNo.matches('MH-[A-Z0-9]{3,18}') && orderId == d.orderNo
        && d.uid == request.auth.uid
        && d.email is string && d.email.size() <= 200 && d.email == request.auth.token.email
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.contact is string && d.contact.size() > 0 && d.contact.size() <= 100
        && d.delivery is string && d.delivery.size() <= 100
        && d.address is string && d.address.size() <= 500
        && d.notes is string && d.notes.size() <= 1000
        && d.items is list && d.items.size() > 0 && d.items.size() <= 40
        && d.total is number && d.total >= 0 && d.total < 1000000
        && d.agreed == true
        && d.status == 'new'
        && d.createdAt == request.time;
    }

    function optStr(d, k, max) {
      return !(k in d) || (d[k] is string && d[k].size() <= max);
    }
    function optList(d, k) {
      return !(k in d) || (d[k] is list && d[k].size() <= 6);
    }

    function validProduct() {
      let d = request.resource.data;
      let keys = ['group', 'name', 'price', 'tag', 'image', 'status', 'order'];
      return d.keys().hasOnly(['group', 'name', 'price', 'tag', 'image', 'status', 'order', 'channels', 'eta', 'stock', 'aliases', 'addons', 'salePrice', 'saleEnds']) && d.keys().hasAll(keys)
        && (!('salePrice' in d) || (d.salePrice is number && d.salePrice >= 0 && d.salePrice < 1000000))
        && optStr(d, 'saleEnds', 10)
        && (!('stock' in d) || (d.stock is number && d.stock > -100000 && d.stock < 100000))
        && (!('aliases' in d) || (d.aliases is list && d.aliases.size() <= 30))
        && (!('addons' in d) || (d.addons is list && d.addons.size() <= 12))
        && (!('channels' in d) || (d.channels is list && d.channels.size() <= 3 && d.channels.hasOnly(['stock', 'preorder', 'sf'])))
        && optStr(d, 'eta', 60)
        && d.group is string && d.group.size() > 0 && d.group.size() <= 60
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.price is number && d.price >= 0 && d.price < 1000000
        && d.tag is string && d.tag.size() <= 30
        && d.image is string && d.image.size() <= 400000
        && d.status in ['ok', 'pending', 'sold', 'store', 'hidden']
        && d.order is number;
    }

    function validSite() {
      let d = request.resource.data;
      return d.keys().hasOnly(['headline', 'intro', 'shelfNote', 'hours', 'addressShort', 'addressLines', 'stall', 'enquiryNote', 'claims', 'instagram', 'paymentNote', 'ordersOpen'])
        && optStr(d, 'headline', 200) && optStr(d, 'intro', 600) && optStr(d, 'shelfNote', 300)
        && optStr(d, 'hours', 100) && optStr(d, 'addressShort', 150) && optStr(d, 'enquiryNote', 300)
        && optStr(d, 'claims', 300) && optStr(d, 'instagram', 60) && optStr(d, 'paymentNote', 500)
        && optList(d, 'addressLines') && optList(d, 'stall')
        && (!('ordersOpen' in d) || d.ordersOpen is bool);
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update: if isAdmin() && validProduct();
      allow delete: if isAdmin();
    }

    function validPayment() {
      let d = request.resource.data;
      let keys = ['name', 'type', 'details', 'link', 'image', 'order', 'enabled'];
      return d.keys().hasOnly(keys) && d.keys().hasAll(keys)
        && d.name is string && d.name.size() > 0 && d.name.size() <= 40
        && d.type in ['qr', 'text', 'link']
        && d.details is string && d.details.size() <= 600
        && d.link is string && d.link.size() <= 300 && (d.link == '' || d.link.matches('https://.*'))
        && d.image is string && d.image.size() <= 400000
        && d.order is number
        && d.enabled is bool;
    }

    // Payment screenshots that customers upload on the payment page. Only the admin can see them.
    // The order must exist and belong to the signed-in customer.
    function validProof() {
      let d = request.resource.data;
      return verified()
        && d.keys().hasOnly(['orderNo', 'image', 'note', 'createdAt'])
        && d.orderNo is string && d.orderNo.matches('MH-[A-Z0-9]{3,18}')
        && d.image is string && d.image.size() <= 400000 && d.image.matches('data:image/(jpeg|png|webp);base64,.*')
        && d.note is string && d.note.size() <= 200
        && d.createdAt == request.time
        && exists(/databases/$(database)/documents/orders/$(d.orderNo))
        && get(/databases/$(database)/documents/orders/$(d.orderNo)).data.uid == request.auth.uid;
    }

    match /proofs/{proofId} {
      allow create: if validProof();
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // Payment methods (QR codes, account details) are only shown to signed-in customers and the admin.
    match /payments/{paymentId} {
      allow read: if verified() || isAdmin();
      allow create, update: if isAdmin() && validPayment();
      allow delete: if isAdmin();
    }

    match /settings/site {
      allow read: if true;
      allow create, update: if isAdmin() && validSite();
      allow delete: if false;
    }

    // Wording of the website pages (every key is a piece of text; see the 全部文字 tab on the admin page).
    match /settings/texts {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['t'])
        && request.resource.data.t is map
        && request.resource.data.t.size() <= 700;
      allow delete: if false;
    }

    // ---- Shop management (admin page only): bulk orders / costs, sales records, rent and other costs ----
    function validPurchase() {
      let d = request.resource.data;
      return d.keys().hasOnly(['date', 'supplier', 'currency', 'rate', 'shipping', 'otherFees', 'allocate', 'note', 'lines', 'updatedAt'])
        && d.keys().hasAll(['date', 'currency', 'rate', 'shipping', 'otherFees', 'allocate', 'lines'])
        && d.date is string && d.date.size() == 10
        && optStr(d, 'supplier', 100) && optStr(d, 'note', 500)
        && d.currency in ['HKD', 'KRW', 'CNY', 'USD', 'JPY', 'TWD', 'EUR']
        && d.rate is number && d.shipping is number && d.otherFees is number
        && d.allocate in ['qty', 'value']
        && d.lines is list && d.lines.size() <= 80;
    }
    function validSale() {
      let d = request.resource.data;
      return d.keys().hasOnly(['date', 'time', 'receipt', 'payment', 'source', 'items', 'total', 'discount', 'note', 'orderNo', 'createdAt'])
        && d.keys().hasAll(['date', 'source', 'items', 'total'])
        && d.date is string && d.date.size() == 10
        && d.source in ['pos', 'import', 'web']
        && d.items is list && d.items.size() <= 150
        && d.total is number
        && optStr(d, 'time', 10) && optStr(d, 'receipt', 60) && optStr(d, 'payment', 30) && optStr(d, 'note', 300) && optStr(d, 'orderNo', 30);
    }
    function validExpense() {
      let d = request.resource.data;
      return d.keys().hasOnly(['date', 'name', 'category', 'amount', 'repeat', 'endDate', 'note'])
        && d.keys().hasAll(['date', 'name', 'category', 'amount', 'repeat'])
        && d.date is string && d.date.size() == 10
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.category in ['rent', 'other']
        && d.amount is number
        && d.repeat in ['none', 'monthly', 'yearly']
        && optStr(d, 'endDate', 10) && optStr(d, 'note', 300);
    }
    match /purchases/{id} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin() && validPurchase();
    }
    match /sales/{id} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin() && validSale();
    }
    match /expenses/{id} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin() && validExpense();
    }

    // ---- Content pages: products coming soon, and extra pages (discounts etc.). Visitors only see published ones. ----
    function validUpcoming() {
      let d = request.resource.data;
      return d.keys().hasOnly(['title', 'group', 'image', 'releaseDate', 'releaseText', 'price', 'note', 'storeOnly', 'linkLabel', 'link', 'published', 'autoSell', 'converted', 'updatedAt'])
        && d.keys().hasAll(['title', 'published'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.published is bool
        && optStr(d, 'group', 60) && optStr(d, 'releaseDate', 10) && optStr(d, 'releaseText', 60)
        && optStr(d, 'note', 600) && optStr(d, 'linkLabel', 30) && optStr(d, 'link', 300)
        && (!('image' in d) || (d.image is string && d.image.size() <= 400000))
        && (!('price' in d) || (d.price is number && d.price >= 0 && d.price < 1000000))
        && (!('storeOnly' in d) || d.storeOnly is bool)
        && (!('autoSell' in d) || d.autoSell is bool)
        && (!('converted' in d) || d.converted is bool);
    }
    match /upcoming/{id} {
      allow read: if isAdmin() || resource.data.published == true;
      allow create, update: if isAdmin() && validUpcoming();
      allow delete: if isAdmin();
    }
    function validPage(slug) {
      let d = request.resource.data;
      return d.keys().hasOnly(['slug', 'title', 'subtitle', 'banner', 'published', 'showInNav', 'navLabel', 'homeButton', 'homeLabel', 'order', 'blocks', 'updatedAt'])
        && d.keys().hasAll(['slug', 'title', 'published', 'blocks'])
        && d.slug == slug && d.slug.matches('[a-z0-9-]{1,40}')
        && d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.published is bool
        && optStr(d, 'subtitle', 300) && optStr(d, 'navLabel', 20) && optStr(d, 'homeLabel', 30)
        && (!('banner' in d) || (d.banner is string && d.banner.size() <= 400000))
        && d.blocks is list && d.blocks.size() <= 40;
    }
    match /pages/{slug} {
      allow read: if isAdmin() || resource.data.published == true;
      allow create, update: if isAdmin() && validPage(slug);
      allow delete: if isAdmin();
    }

    // ---- Membership: every registered account has a member record; points are added by the admin page ----
    function validMemberSelf(uid) {
      let d = request.resource.data;
      let keys = ['uid', 'email', 'name', 'points', 'spent', 'joinedAt'];
      return verified() && request.auth.uid == uid
        && d.keys().hasOnly(keys) && d.keys().hasAll(keys)
        && d.uid == uid && d.email == request.auth.token.email
        && d.name is string && d.name.size() <= 60
        && d.points == 0 && d.spent == 0
        && d.joinedAt == request.time;
    }
    function validMemberAdmin() {
      let d = request.resource.data;
      return d.keys().hasOnly(['uid', 'email', 'name', 'points', 'spent', 'joinedAt', 'note', 'updatedAt', 'lastRedeem'])
        && d.keys().hasAll(['uid', 'email', 'points', 'spent'])
        && d.uid is string && d.email is string && d.points is number && d.spent is number
        && optStr(d, 'name', 60) && optStr(d, 'note', 300);
    }
    // A member may lower their OWN points, and only together with a redemption created in the same batch for exactly that many points.
    function validMemberRedeem(uid) {
      let n = request.resource.data;
      let o = resource.data;
      let red = /databases/$(database)/documents/redemptions/$(n.lastRedeem);
      return verified() && request.auth.uid == uid
        && n.diff(o).affectedKeys().hasOnly(['points', 'lastRedeem', 'updatedAt'])
        && n.lastRedeem is string
        && !exists(red)
        && getAfter(red).data.uid == uid
        && n.points >= 0 && n.points == o.points - getAfter(red).data.points;
    }
    // A member may change their OWN name (and nothing else): the document must already exist and points / spent stay as they are.
    function validMemberName(uid) {
      let n = request.resource.data;
      return verified() && request.auth.uid == uid
        && n.diff(resource.data).affectedKeys().hasOnly(['name', 'updatedAt'])
        && n.name is string && n.name.size() > 0 && n.name.size() <= 60
        && n.updatedAt == request.time;
    }
    match /members/{uid} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create: if validMemberSelf(uid) || (isAdmin() && validMemberAdmin());
      allow update: if (isAdmin() && validMemberAdmin()) || validMemberRedeem(uid) || validMemberName(uid);
      allow delete: if isAdmin();
    }
    function validPointLog() {
      let d = request.resource.data;
      return d.keys().hasOnly(['uid', 'orderNo', 'points', 'type', 'note', 'createdAt'])
        && d.keys().hasAll(['uid', 'points', 'type', 'createdAt'])
        && d.uid is string && d.points is number && d.type in ['earn', 'adjust', 'redeem']
        && optStr(d, 'orderNo', 30) && optStr(d, 'note', 200);
    }
    function validRedeemLog(logId) {
      let d = request.resource.data;
      let red = getAfter(/databases/$(database)/documents/redemptions/$(logId.replace('^redeem-', '')));
      return verified() && logId.matches('redeem-.*') && validPointLog()
        && d.uid == request.auth.uid && d.type == 'redeem'
        && red.data.uid == request.auth.uid && d.points == -red.data.points;
    }
    match /pointlogs/{logId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if (isAdmin() && validPointLog()) || validRedeemLog(logId);
      allow update: if false;
      allow delete: if isAdmin();
    }
    match /settings/member {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['enabled', 'per', 'tiers'])
        && request.resource.data.enabled is bool && request.resource.data.per is number && request.resource.data.per > 0
        && request.resource.data.tiers is list && request.resource.data.tiers.size() <= 6;
      allow delete: if false;
    }

    // ---- Products members can swap points for ----
    match /rewards/{id} {
      allow read: if isAdmin() || resource.data.active == true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'points', 'productId', 'active', 'order', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.points is number && request.resource.data.points > 0 && request.resource.data.points < 10000000
        && request.resource.data.active is bool;
      allow delete: if isAdmin();
    }
    function validRedemption(rid) {
      let d = request.resource.data;
      let rw = get(/databases/$(database)/documents/rewards/$(d.rewardId)).data;
      let mine = /databases/$(database)/documents/members/$(request.auth.uid);
      return verified()
        && d.keys().hasOnly(['uid', 'email', 'rewardId', 'name', 'points', 'status', 'createdAt'])
        && d.keys().hasAll(['uid', 'email', 'rewardId', 'name', 'points', 'status', 'createdAt'])
        && d.uid == request.auth.uid && d.email == request.auth.token.email
        && d.status == 'new' && d.createdAt == request.time
        && rw.active == true && d.name == rw.name && d.points == rw.points
        && get(mine).data.points >= d.points
        && getAfter(mine).data.lastRedeem == rid;
    }
    match /redemptions/{rid} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if validRedemption(rid);
      allow update: if isAdmin() && resource.data.status == 'new'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['fulfilled', 'cancelled'];
      allow delete: if false;
    }

    // ---- Discount codes. Each code lives under the SHA-256 of its text: the list is admin-only, a customer can only
    //      fetch the one document whose id they can already compute from a code they were given. ----
    match /codes/{id} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create, update: if (isAdmin() && validCode()) || validCodeUse();
      allow delete: if isAdmin();
    }
    function validCode() {
      let d = request.resource.data;
      return d.keys().hasOnly(['code', 'type', 'value', 'active', 'used', 'maxUses', 'perCustomer', 'minSpend', 'expires', 'expiresAt', 'email', 'note', 'createdAt', 'lastOrder'])
        && d.code is string && d.code.size() >= 4 && d.code.size() <= 24
        && d.type in ['percent', 'amount'] && d.value is number && d.value > 0 && d.value < 1000000
        && (d.type != 'percent' || d.value <= 100)
        && d.active is bool && d.used is number
        && optStr(d, 'note', 100) && optStr(d, 'email', 200) && optStr(d, 'expires', 10);
    }
    // customers: the only change they may make to a code is "used + 1", together with the order that used it
    function validCodeUse() {
      let n = request.resource.data;
      let o = resource.data;
      let order = /databases/$(database)/documents/orders/$(n.lastOrder);
      return verified()
        && n.diff(o).affectedKeys().hasOnly(['used', 'lastOrder'])
        && n.used == o.used + 1 && n.lastOrder is string
        && !exists(order) && getAfter(order).data.codeId == resource.id && getAfter(order).data.uid == request.auth.uid;
    }
    match /codes/{id}/uses/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if verified() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1;
      allow update: if verified() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == resource.data.n + 1;
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if validOrder(orderId);
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'progress', 'tracking', 'customerNote'])
        && request.resource.data.status in ['new', 'confirmed', 'done', 'cancelled']
        && (!('progress' in request.resource.data) || request.resource.data.progress in ['received', 'paid', 'ordering', 'arrived', 'shipped', 'ready', 'done'])
        && optStr(request.resource.data, 'tracking', 60) && optStr(request.resource.data, 'customerNote', 300);
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
