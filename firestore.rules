rules_version = '2';

// Who can do what with orders:
//  - Anyone visiting the website can ADD a new order (only with the fields below).
//  - Nobody can read the orders list except the shop admin (signed in with the admin email).
//  - The admin can change an order's status, nothing else. Nobody can delete.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['__ADMIN_EMAIL__'];
    }

    function validOrder() {
      let d = request.resource.data;
      return d.keys().hasOnly(['orderNo', 'name', 'contact', 'delivery', 'address', 'notes', 'items', 'total', 'status', 'createdAt'])
        && d.orderNo is string && d.orderNo.size() > 0 && d.orderNo.size() <= 20
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.contact is string && d.contact.size() > 0 && d.contact.size() <= 100
        && d.delivery is string && d.delivery.size() <= 100
        && d.address is string && d.address.size() <= 500
        && d.notes is string && d.notes.size() <= 1000
        && d.items is list && d.items.size() > 0 && d.items.size() <= 40
        && d.total is number && d.total >= 0 && d.total < 1000000
        && d.status == 'new'
        && d.createdAt == request.time;
    }

    match /orders/{orderId} {
      allow create: if validOrder();
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['new', 'confirmed', 'done', 'cancelled'];
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
